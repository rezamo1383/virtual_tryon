APP_ENV=development
LOG_LEVEL=INFO

TENANT_CONFIG_PATH=config/tenants.json
DEFAULT_TENANT_ID=legacy-clothing
# Set true in production after configuring api_key_sha256 for every tenant.
TENANT_AUTH_REQUIRED=false

MAX_IMAGE_SIZE_MB=10
MIN_IMAGE_WIDTH=512
MIN_IMAGE_HEIGHT=512
MAX_IMAGE_DIMENSION=12000
MIN_ASPECT_RATIO=0.2
MAX_ASPECT_RATIO=5.0

QWEN_API_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_TIMEOUT_SECONDS=60
QWEN_VALIDATION_RETRIES=2
USE_MOCK_QWEN=true

# Provider selectors:
# auto = preserve the legacy USE_MOCK_* behavior
# Supported explicit providers:
# ANALYSIS_PROVIDER=mock|qwen|openrouter|gapgpt
# TRYON_PROVIDER=mock|generic|openrouter|gapgpt
ANALYSIS_PROVIDER=auto
TRYON_PROVIDER=auto

OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Choose a vision-capable model that supports JSON output.
OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
# Choose a model whose Image API supports image input_references.
OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Virtual Try-On
OPENROUTER_IMAGE_QUALITY=high
# Leave empty to let the provider choose, or use a supported value.
OPENROUTER_IMAGE_SIZE=

# GapGPT Platform V2 (API wallet/key; this is separate from chat subscriptions).
GAPGPT_API_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_API_KEY=
GAPGPT_VISION_MODEL=gpt-4o
GAPGPT_IMAGE_MODEL=gpt-image-2
GAPGPT_TIMEOUT_SECONDS=180
# Reference-preserving try-on requires the image edit API, not text-only generations.
GAPGPT_IMAGE_EDIT_ENDPOINT=/images/edits
# OpenAI-compatible multipart APIs commonly accept repeated image[] fields.
# Change to image only if GapGPT support instructs you to do so.
GAPGPT_IMAGE_FIELD_NAME=image[]
GAPGPT_IMAGE_QUALITY=medium
GAPGPT_IMAGE_SIZE=1024x1536
GAPGPT_WALLPAPER_IMAGE_SIZE=auto

TRYON_API_BASE_URL=
TRYON_API_KEY=
TRYON_MODEL=
TRYON_TIMEOUT_SECONDS=180
USE_MOCK_TRYON=true
# Enable only for Generic REST providers that accept a replace_mask file.
TRYON_PROVIDER_SUPPORTS_MASK=false

CANDIDATES_PER_COLOR=2
MAX_GENERATION_RETRIES=1
MIN_ACCEPTANCE_SCORE=0.80
WALLPAPER_MIN_ACCEPTANCE_SCORE=0.75
WALLPAPER_MASK_FEATHER_RADIUS=1
# semantic = local ADE20K pixel mask (recommended); polygon = coarse Vision quad.
WALLPAPER_SEGMENTATION_BACKEND=semantic
WALLPAPER_SEGMENTATION_RUNTIME=onnx
WALLPAPER_SEGMENTATION_MODEL=nvidia/segformer-b2-finetuned-ade-512-512
WALLPAPER_SEGMENTATION_ONNX_URL=https://huggingface.co/Xenova/segformer-b2-finetuned-ade-512-512/resolve/main/onnx/model.onnx
WALLPAPER_SEGMENTATION_ONNX_FILENAME=segformer-b2-ade512.onnx
WALLPAPER_SEGMENTATION_ONNX_SHA256=819c15e6af8c4de3359c1de7ab0a17d0dde495df1d16f8908a7163f8038e0fa0
WALLPAPER_SEGMENTATION_DEVICE=auto
WALLPAPER_WALL_CONFIDENCE_THRESHOLD=0.25
WALLPAPER_MIN_WALL_REGION_COVERAGE=0.001
WALLPAPER_MIN_WALL_COMPONENT_RATIO=0.01
# Disabled by default: no person Vision-LLM call and no person_analysis.json.
PERSON_ANALYSIS_ENABLED=false
# Used only when PERSON_ANALYSIS_ENABLED=true.
REJECT_UNSUITABLE_PERSON_IMAGES=true

LOCAL_PREPROCESSING_ENABLED=true
PERSON_PRESENCE_CHECK_ENABLED=true
BACKGROUND_REMOVAL_ENABLED=false
POSE_ESTIMATION_ENABLED=false
HUMAN_PARSING_ENABLED=true
HUMAN_PARSING_REQUIRED=false
PREPROCESSING_DEVICE=auto

PERSON_TARGET_WIDTH=768
PERSON_TARGET_HEIGHT=1024
GARMENT_TARGET_WIDTH=768
GARMENT_TARGET_HEIGHT=1024
PREPROCESSING_INFERENCE_MAX_DIMENSION=1600

POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_TRACKING_CONFIDENCE=0.5
MIN_SHOULDER_VISIBILITY=0.55
MIN_TRYON_SUITABILITY_SCORE=0

MASK_MORPHOLOGY_KERNEL=5
MASK_DILATION_KERNEL=9
MASK_DILATION_ITERATIONS=1
MASK_FEATHER_RADIUS=5

SAVE_PREPROCESSING_DEBUG_IMAGES=true
PREPROCESSING_FAIL_OPEN=false
PREPROCESSING_TIMEOUT_SECONDS=120
PREPROCESSING_MAX_CONCURRENCY=1

MODEL_CACHE_DIRECTORY=models
LOCAL_MODEL_OFFLINE_MODE=false
MODEL_DOWNLOAD_TIMEOUT_SECONDS=120
BACKGROUND_REMOVAL_PERSON_MODEL=u2net_human_seg
BACKGROUND_REMOVAL_GARMENT_MODEL=u2netp
HUMAN_PARSING_MODEL_URL=https://huggingface.co/pirocheto/schp-atr-18/resolve/main/onnx/schp-atr-18-int8-static.onnx
HUMAN_PARSING_MODEL_FILENAME=schp-atr-18-int8-static.onnx
# Optional SHA-256 pin. Leave empty to trust HTTPS and the model cache.
HUMAN_PARSING_MODEL_SHA256=

TEMP_DIRECTORY=temp
OUTPUT_DIRECTORY=outputs
LOG_DIRECTORY=logs
DELETE_TEMP_FILES=true
